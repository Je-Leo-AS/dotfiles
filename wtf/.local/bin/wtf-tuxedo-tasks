#!/usr/bin/env bash
set -euo pipefail

commands=(
  tuxedo-control-center
  tuxedo-control-center-bin
  tuxedo-control-center-git
  /opt/tuxedo-control-center/tuxedo-control-center
)

is_running() {
  pgrep -f 'tuxedo-control-center' >/dev/null 2>&1
}

printf 'TUXEDO Control Center\n\n'

if is_running; then
  printf 'Status: aberto\n'
  exit 0
fi

for cmd in "${commands[@]}"; do
  if [[ "$cmd" == */* ]]; then
    [[ -x "$cmd" ]] || continue
    setsid -f "$cmd" >/dev/null 2>&1 || true
    sleep 1
    if is_running; then
      printf 'Status: aberto agora\n'
      printf 'Comando: %s\n' "$cmd"
      exit 0
    fi
  elif command -v "$cmd" >/dev/null 2>&1; then
    setsid -f "$cmd" >/dev/null 2>&1 || true
    sleep 1
    if is_running; then
      printf 'Status: aberto agora\n'
      printf 'Comando: %s\n' "$cmd"
      exit 0
    fi
  fi
done

printf 'Status: aplicativo nao encontrado no PATH\n'
printf 'Esperado: tuxedo-control-center\n'
printf 'Obs: este board dispara o app grafico; ele nao roda embutido no terminal.\n'
