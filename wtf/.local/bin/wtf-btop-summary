#!/usr/bin/env bash
set -euo pipefail

printf "Full monitor: run sysdash or btop\n\n"

printf "Load:   %s\n" "$(uptime | sed 's/.*load average: //')"

printf "Memory: "
free -h | awk '/^Mem:/ { print $3 " used / " $2 " total (" $7 " available)" }'

printf "Disk:   "
df -h "$HOME" | awk 'NR == 2 { print $3 " used / " $2 " total (" $5 ")" }'

printf "\nTop CPU processes:\n"
ps -eo pid=,pcpu=,pmem=,comm= --sort=-pcpu | awk 'NR <= 5 {
  cmd=$4
  for (i=5; i<=NF; i++) cmd=cmd " " $i
  if (length(cmd) > 18) cmd=substr(cmd, 1, 18)
  printf "  %-18s %6s  CPU %5s%%  MEM %5s%%\n", cmd, $1, $2, $3
}'

printf "\nNetwork interfaces:\n"
ip -brief addr show up 2>/dev/null | awk '{ printf "  %-12s %s\n", $1, $3 }' | head -5
